# ---- InferOps configuration (copy to .env and adjust) ----

# Application
APP_NAME=InferOps
ENVIRONMENT=local

# Local inference (Ollama). Set ENABLE_OLLAMA=false to force the offline
# deterministic engine (handy for CI / demos without a GPU).
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
REQUEST_TIMEOUT=60

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Agent
MAX_AGENT_STEPS=6

# Data
DATA_DIR=data
